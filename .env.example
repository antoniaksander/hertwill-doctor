# Hertwill Doctor example configuration.
# Copy to .env for local use. Keep real credentials out of version control.

# WooCommerce requires the complete credential set.
WOO_BASE_URL=https://example.com
WOO_CONSUMER_KEY=ck_your_consumer_key_here
WOO_CONSUMER_SECRET=cs_your_consumer_secret_here

# Hertwill v1 supports static access token authentication cleanly.
HERTWILL_ACCESS_TOKEN=your_hertwill_access_token_here

# Optional. Defaults to https://api.hertwill.com when unset.
HERTWILL_BASE_URL=https://api.hertwill.com

# Email/password auth is documented but not attempted until the endpoint is verified.
# HERTWILL_EMAIL=user@example.com
# HERTWILL_PASSWORD=your_hertwill_password_here

# Timeout for all HTTP requests. Must be a positive integer.
HWD_TIMEOUT_SECONDS=30
